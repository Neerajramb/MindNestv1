# Copy to backend/.env and fill in. Never commit backend/.env.

DJANGO_DEBUG=true
# Required when DJANGO_DEBUG=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# Add your laptop's LAN IP and any tunnel hostname (comma-separated).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# Defaults to SQLite in backend/db.sqlite3. PostgreSQL example:
# DATABASE_URL=postgres://mindnest:password@localhost:5432/mindnest
DATABASE_URL=

# --- AI providers ---
# Gemini FREE tier: Google may use inputs for training and human review.
# Use synthetic/demo data only. Never real patient data on the free tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# gemini | ollama | none   (none = deterministic answers only)
LLM_PROVIDER=gemini
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3

# Thresholds (tune with the evaluation scripts; AI spec section 16)
FACE_MATCH_THRESHOLD=0.40
MEMORY_MIN_SIMILARITY=0.30

# Policy
REMINDER_HORIZON_HOURS=48
REMINDER_MISSED_GRACE_MINUTES=30
APPOINTMENT_REMINDER_LEAD_MINUTES=60
LOCATION_RETENTION_DAYS=30
LOCATION_STALE_MINUTES=60
